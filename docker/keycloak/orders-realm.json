{
  "realm": "orders",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "orders:read",
      "description": "Read orders",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" }
    },
    {
      "name": "orders:write",
      "description": "Cancel orders",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "orders-agent",
      "name": "AI agent with read + write access (demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "orders-agent-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "orders:read"],
      "optionalClientScopes": ["orders:write"]
    },
    {
      "clientId": "orders-readonly",
      "name": "AI agent with read-only access (demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "orders-readonly-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["basic", "orders:read"],
      "optionalClientScopes": []
    }
  ]
}
